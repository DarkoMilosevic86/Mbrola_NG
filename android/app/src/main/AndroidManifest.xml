<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- only to download voices -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- directBootAware: the engine must speak before the first unlock after
         a reboot (TalkBack on the lock screen). All data it needs is in
         device-protected storage, see VoiceStore.storage(). -->
    <application
        android:allowBackup="false"
        android:directBootAware="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MbrolaNg">

        <!-- Voice manager; also "install voice data" from the system -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Voice settings = the engine settings opened from the system's
             text-to-speech settings (res/xml/tts_engine.xml) -->
        <activity
            android:name=".VoiceSettingsActivity"
            android:exported="true"
            android:label="@string/voice_settings" />

        <activity
            android:name=".CheckVoiceData"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GetSampleText"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The text-to-speech engine -->
        <service
            android:name=".MbrolaTtsService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>
    </application>
</manifest>
