# MBROLA NG - editor settings (https://editorconfig.org)
# Copyright (c) 2026 Darko Milošević
# SPDX-License-Identifier: GPL-2.0-or-later
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,txt,cmake,sh,json,md,conf,iss}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

# Python follows NVDA's style: tabs
[*.py]
indent_style = tab

[languages/**.txt]
trim_trailing_whitespace = false
