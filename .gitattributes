# Text files are stored with LF in the repository.
* text=auto

# Must keep LF on every system (shebang scripts run on Linux)
*.sh      text eol=lf
linux/**  text eol=lf
*.py      text eol=lf

# Windows-only files keep CRLF
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.iss     text eol=crlf
*.isl     text eol=crlf
*.rc      text eol=crlf
*.def     text eol=crlf

# Binary
*.dat     binary
*.exe     binary
*.dll     binary
*.png     binary
*.ico     binary
*.zip     binary
*.jar     binary
*.jks     binary
*.wav     binary
*.webp    binary
gradlew   text eol=lf
*.nvda-addon binary

# Statistics: vendored MBROLA and the big language data are not "our" code
external/**           linguist-vendored
languages/**/*.txt    linguist-detectable=false
ANALYSIS.txt          linguist-documentation
