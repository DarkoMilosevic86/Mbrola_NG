{
  "sourceLanguage": "en",
  "strings": {
    "About MBROLA NG": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplikaciji MBROLA NG"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About MBROLA NG"
          }
        }
      }
    },
    "About this voice": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "O ovom glasu"
