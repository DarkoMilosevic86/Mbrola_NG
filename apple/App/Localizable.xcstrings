        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file is not an MBROLA voice."
          }
        }
      }
    },
    "The license of each voice is on the voice's page.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenca svakog glasa nalazi se na stranici tog glasa."
