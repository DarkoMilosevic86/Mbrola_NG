    "The app collects no data. It uses the internet only to download the voices you install.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija ne prikuplja nikakve podatke. Internet koristi samo za preuzimanje glasova koje instalirate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects no data. It uses the internet only to download the voices you install."
          }
        }
      }
    },
    "The download failed. Check the internet connection and try again.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje nije uspjelo. Provjerite internetsku vezu i pokušajte ponovno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download failed. Check the internet connection and try again."
          }
        }
      }
    },
    "The downloaded file is damaged. Try again.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeta datoteka je oštećena. Pokušajte ponovno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file is damaged. Try again."
          }
        }
      }
    },
    "The downloaded file is not an MBROLA voice.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeta datoteka nije glas za MBROLA."
