    "Authors: Thierry Dutoit and Vincent Pagel. Copyright © 1995–2018 Faculté Polytechnique de Mons (TCTS Lab), Belgium. GNU Affero General Public License, version 3 or later.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autori: Thierry Dutoit i Vincent Pagel. Copyright © 1995–2018 Faculté Polytechnique de Mons (TCTS Lab), Belgija. GNU Affero General Public License, verzija 3 ili novija."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authors: Thierry Dutoit and Vincent Pagel. Copyright © 1995–2018 Faculté Polytechnique de Mons (TCTS Lab), Belgium. GNU Affero General Public License, version 3 or later."
          }
        }
      }
    },
    "Because the MBROLA synthesizer is built into this app, the app as a whole is distributed under the GNU Affero General Public License, version 3. It comes with no warranty. You may redistribute it under the terms of that license.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budući da je sintetizator MBROLA ugrađen u ovu aplikaciju, aplikacija se kao cjelina distribuira pod licencom GNU Affero General Public License, verzija 3. Dolazi bez ikakvog jamstva. Smijete je dalje distribuirati pod uvjetima te licence."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the MBROLA synthesizer is built into this app, the app as a whole is distributed under the GNU Affero General Public License, version 3. It comes with no warranty. You may redistribute it under the terms of that license."
          }
        }
      }
    },
