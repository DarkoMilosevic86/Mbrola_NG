        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MBROLA NG for iOS, iPadOS and macOS"
          }
        }
      }
    },
    "MBROLA NG is free text-to-speech software built on the MBROLA speech synthesizer. It consists of parts by different authors, listed below. The authors of MBROLA NG are not the authors or owners of MBROLA and are not affiliated with them.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "MBROLA NG je slobodan softver za sintezu govora izgrađen na sintetizatoru govora MBROLA. Sastoji se od dijelova različitih autora, koji su navedeni u nastavku. Autori softvera MBROLA NG nisu autori ni vlasnici sintetizatora MBROLA i nisu povezani s njima."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MBROLA NG is free text-to-speech software built on the MBROLA speech synthesizer. It consists of parts by different authors, listed below. The authors of MBROLA NG are not the authors or owners of MBROLA and are not affiliated with them."
          }
        }
      }
    },
