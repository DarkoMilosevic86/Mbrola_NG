    "Text to speak": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst za izgovor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text to speak"
          }
        }
      }
    },
    "The app collects no data. It uses the internet only to download the voices you install. The English pronunciations come from the CMU Pronouncing Dictionary, the emoji names from Unicode CLDR.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija ne prikuplja nikakve podatke. Internet koristi samo za preuzimanje glasova koje instalirate. Engleski izgovori potječu iz rječnika CMU Pronouncing Dictionary, a nazivi emojija iz Unicode CLDR-a."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects no data. It uses the internet only to download the voices you install. The English pronunciations come from the CMU Pronouncing Dictionary, the emoji names from Unicode CLDR."
          }
        }
      }
    },
    "The download failed. Check the internet connection and try again.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje nije uspjelo. Provjerite internetsku vezu i pokušajte ponovno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download failed. Check the internet connection and try again."
          }
        }
      }
    },
    "The downloaded file is damaged. Try again.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeta datoteka je oštećena. Pokušajte ponovno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file is damaged. Try again."
          }
        }
      }
    },
    "The downloaded file is not an MBROLA voice.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeta datoteka nije MBROLA glas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file is not an MBROLA voice."
          }
        }
      }
    },
    "The voice %@ is installed.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glas %@ je instaliran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice %@ is installed."
          }
        }
      }
    },
    "The voice could not speak: %@": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glas ne može govoriti: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice could not speak: %@"
          }
        }
      }
    },
    "The voice is downloaded from the MBROLA voices repository on GitHub after you accept its license.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glas se preuzima iz repozitorija glasova MBROLA na GitHubu nakon što prihvatite njegovu licencu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice is downloaded from the MBROLA voices repository on GitHub after you accept its license."
          }
        }
      }
    },
    "These settings apply wherever the voice speaks. The speed, pitch and volume chosen in VoiceOver or in an app are applied on top of them.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove postavke vrijede gdje god glas govori. Brzina, visina i jačina odabrane u VoiceOveru ili u aplikaciji primjenjuju se povrh njih."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply wherever the voice speaks. The speed, pitch and volume chosen in VoiceOver or in an app are applied on top of them."
          }
        }
      }
    },
    "Try the voice": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isprobajte glas"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the voice"
          }
        }
      }
    },
