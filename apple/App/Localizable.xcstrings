    },
    "No voice is installed yet. Choose a voice below and install it.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nije instaliran nijedan glas. Odaberite glas u nastavku i instalirajte ga."
