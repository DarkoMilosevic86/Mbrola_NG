    "Install (%@)": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaliraj (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install (%@)"
          }
