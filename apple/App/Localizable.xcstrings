    "Downloading: %@ of %@": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzimanje: %1$@ od %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading: %@ of %@"
          }
        }
      }
    },
    "How numbers are read": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Način čitanja brojeva"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How numbers are read"
          }
        }
      }
    },
    "In pairs": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U parovima"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In pairs"
          }
        }
      }
    },
    "Install (%@)": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaliraj (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install (%@)"
          }
        }
      }
    },
    "Installed voices": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirani glasovi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed voices"
          }
        }
      }
    },
    "Installed voices are offered by macOS like its own. For VoiceOver, choose the voice in VoiceOver Utility › Speech. For reading text aloud, choose it in System Settings › Accessibility › Spoken Content › System voice › Manage Voices. A newly installed voice can take up to a minute to appear.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirane glasove macOS nudi kao i svoje. Za VoiceOver odaberite glas u VoiceOver uslužnom programu › Govor. Za čitanje teksta naglas odaberite ga u Postavkama sustava › Pristupačnost › Izgovoreni sadržaj › Glas sustava › Upravljaj glasovima. Može proći do minute dok se novoinstalirani glas ne pojavi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed voices are offered by macOS like its own. For VoiceOver, choose the voice in VoiceOver Utility › Speech. For reading text aloud, choose it in System Settings › Accessibility › Spoken Content › System voice › Manage Voices. A newly installed voice can take up to a minute to appear."
          }
        }
      }
    },
    "Installed voices are offered by the system like its own. For VoiceOver, choose the voice in Settings › Accessibility › VoiceOver › Speech. For Speak Screen and Speak Selection, choose it in Settings › Accessibility › Spoken Content › Voices. A newly installed voice can take up to a minute to appear.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirane glasove sustav nudi kao i svoje. Za VoiceOver odaberite glas u Postavkama › Pristupačnost › VoiceOver › Govor. Za Izgovor zaslona i Izgovor odabira odaberite ga u Postavkama › Pristupačnost › Izgovoreni sadržaj › Glasovi. Može proći do minute dok se novoinstalirani glas ne pojavi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed voices are offered by the system like its own. For VoiceOver, choose the voice in Settings › Accessibility › VoiceOver › Speech. For Speak Screen and Speak Selection, choose it in Settings › Accessibility › Spoken Content › Voices. A newly installed voice can take up to a minute to appear."
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jezik"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        }
      }
    },
    "License": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenca"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "License"
          }
        }
      }
    },
    "License of the voice %@": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenca glasa %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "License of the voice %@"
          }
        }
      }
    },
    "MBROLA NG": {
      "shouldTranslate": false
    },
    "MBROLA NG is text-to-speech built on the MBROLA diphone synthesizer, by Darko Milošević. It is free software under the GNU General Public License, version 2 or later. The MBROLA synthesizer, which is part of this app, is under the GNU Affero General Public License, version 3. Each voice has its own license.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "MBROLA NG je sinteza govora izgrađena na difonskom sintetizatoru MBROLA, autora Darka Miloševića. Slobodan je softver pod Općom javnom licencom GNU, verzija 2 ili novija. Sintetizator MBROLA, koji je dio ove aplikacije, pod licencom je GNU Affero General Public License, verzija 3. Svaki glas ima svoju licencu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MBROLA NG is text-to-speech built on the MBROLA diphone synthesizer, by Darko Milošević. It is free software under the GNU General Public License, version 2 or later. The MBROLA synthesizer, which is part of this app, is under the GNU Affero General Public License, version 3. Each voice has its own license."
          }
        }
      }
    },
    "Modulation": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modulacija"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modulation"
          }
        }
      }
    },
    "No voice is installed yet. Choose a voice below and install it.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Još nije instaliran nijedan glas. Odaberite glas ispod i instalirajte ga."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No voice is installed yet. Choose a voice below and install it."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U redu"
