            "value": "Postavke glasa"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice settings"
          }
        }
      }
    },
    "Voices cannot be stored: the app is not signed with its App Group.": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasove nije moguće spremiti: aplikacija nije potpisana sa svojom grupom aplikacija (App Group)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voices cannot be stored: the app is not signed with its App Group."
          }
        }
      }
    },
    "Voices to install: %@": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasovi za instalaciju: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voices to install: %@"
          }
        }
      }
    },
    "Volume": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jačina"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume"
          }
        }
      }
    },
    "Waiting for the license": {
      "localizations": {
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeka se licenca"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the license"
          }
        }
      }
    }
  },
  "version": "1.0"
}